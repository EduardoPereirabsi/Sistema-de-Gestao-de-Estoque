@startuml atividade-movimentacao-estoque
title Diagrama de Atividades — Caso de Uso Principal (Core)\nSmartStock: Registrar Movimentação de Estoque

skinparam activityBackgroundColor #FAFFF0
skinparam activityBorderColor #336600
skinparam arrowColor #333333

|Operador / Gerente|
start
:Acessa tela de Movimentações;
:Seleciona produto, tipo\n(ENTRADA / SAÍDA / AJUSTE),\nquantidade e motivo;
:Confirma o registro;

|Frontend (React)|
:Envia POST /api/stock-movements;

|Backend (Service)|
:Obtém contexto da empresa autenticada;
:Busca produto pelo ID na empresa;

if (Produto existe e está ativo?) then (não)
  :Lança RecursoNaoEncontradoException;
  |Frontend (React)|
  :Exibe erro 404 — Produto não encontrado;
  |Operador / Gerente|
  :Visualiza mensagem de erro;
  stop
else (sim)
endif

|Backend (Service)|
if (Tipo == SAÍDA?) then (sim)
  if (Estoque >= quantidade solicitada?) then (não)
    :Lança EstoqueInsuficienteException;
    |Frontend (React)|
    :Exibe erro 422 — Estoque insuficiente;
    |Operador / Gerente|
    :Visualiza alerta de estoque insuficiente;
    stop
  else (sim)
    |Backend (Service)|
    :produto.quantidade -= solicitado;
  endif
elseif (Tipo == ENTRADA?) then (sim)
  :produto.quantidade += solicitado;
else (AJUSTE)
  :produto.quantidade = solicitado (absoluto);
endif

:Persiste produto com nova quantidade;
:Cria e persiste MovimentacaoEstoque\n(registro de auditoria imutável);

if (Estoque abaixo do mínimo?) then (sim)
  :Publica alerta via WebSocket\n/topic/low-stock;
  |Frontend (React)|
  :Exibe notificação push de\nestoque baixo em tempo real;
else (não)
endif

|Backend (Service)|
:Retorna MovimentacaoResponse (201 Created);

|Frontend (React)|
:Atualiza listagem de movimentações;

|Operador / Gerente|
:Visualiza confirmação do registro;

stop
@enduml
